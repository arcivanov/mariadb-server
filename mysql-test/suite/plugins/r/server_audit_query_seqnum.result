#
# MDEV-37004: Audit Plugin not in correct order for AFTER trigger
#
install plugin server_audit soname 'server_audit';
set global server_audit_file_path='server_audit_seqnum.log';
set global server_audit_output_type=file;
set global server_audit_mode=0;
set global server_audit_events='QUERY';
set global server_audit_log_query_seqnum=ON;
set global server_audit_logging=on;

# Create test database and tables as in JIRA
CREATE DATABASE IF NOT EXISTS test;
USE test;
# Create tables exactly as in MDEV-37004
CREATE TABLE source (
id bigint(20) NOT NULL AUTO_INCREMENT,
PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci;
CREATE TABLE dest (
id bigint(20) NOT NULL,
PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci;
# Create the trigger exactly as in MDEV-37004
CREATE TRIGGER test_trigger 
AFTER INSERT ON source 
FOR EACH ROW 
INSERT INTO dest (id) VALUES(NEW.id)//
# Insert a row to trigger the AFTER trigger
INSERT INTO source VALUES (NULL);
# Insert another row to see the pattern
INSERT INTO source VALUES (NULL);
# Test with multi-row insert
INSERT INTO source VALUES (NULL), (NULL);
# Clean up
DROP TABLE source, dest;
DROP DATABASE test;
# Wait for audit events to be written
set global server_audit_logging=off;
uninstall plugin server_audit;
#
# Check the audit log output
# According to MDEV-37004, the issue is that trigger statements appear
# in the log BEFORE the triggering statement, despite both having the
# same query_id. With query_seqnum, we should see:
# - Main INSERT with query_seqnum=0
# - Trigger INSERT with query_seqnum=1
# But currently they appear in wrong order in the log.
#